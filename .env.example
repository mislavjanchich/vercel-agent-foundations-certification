# Ship It Shop — environment template
# Copy to .env.local and fill in values. Or run: vercel env pull .env.local

# Required. Vercel deployment-protection bypass secret. Sent as the
# x-vercel-protection-bypass header on every server-side API call.
# Server-only — never give it a NEXT_PUBLIC_ prefix.
BYPASS_SECRET=

# Optional. Override the backend API base URL.
# Defaults to https://vercel-agentic-swag-store-api.vercel.app/api
# API_BASE_URL=

# Optional. Vercel AI Gateway API key for the agent chats. Used on Vercel
# via the project environment (Secret) and locally when LOCAL_LLM_* is not
# set. On Vercel the app can also authenticate via OIDC without a key.
# Create one at https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=

# Optional. Override the AI Gateway model id used by both agents.
# Default in code is 'anthropic/claude-haiku-5.5' (paid tier); this project
# runs 'openai/gpt-4.1-mini' on the gateway free tier.
# AGENT_MODEL=openai/gpt-4.1-mini

# Optional. Admin agent password. Defaults to the demo password
# 'letmeinadminagent' (certification default). Set only to override it.
# ADMIN_PASSWORD=

# Local development only: project OIDC token used by @vercel/oidc to
# authenticate to the Vercel Sandbox when running outside Vercel.
# Obtain with: vercel env pull
# VERCEL_OIDC_TOKEN=

# Optional. Public site URL used for metadata.
# Defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=

# Local development only: bypass Vercel AI Gateway with a local
# OpenAI-compatible model server (e.g. Ollama at http://localhost:11434/v1,
# LM Studio at http://localhost:1234/v1). When set, agent chats run against
# the local model instead of the gateway — useful if the gateway billing is
# not set up yet. NEVER set these in the Vercel project environment.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=lfm2.5:latest
# LOCAL_LLM_API_KEY= (optional, most local servers ignore it)
